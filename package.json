{
  "name": "doc-tracking-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test scripts/test-*.test.mjs scripts/test-delivery-verification.mjs && npm run test:money",
    "typecheck": "tsc --noEmit --incremental false",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate:receipt-signatures": "node --env-file=.env.local scripts/run-receipt-signatures.mjs",
    "db:migrate:document-no-over-999": "node --env-file=.env.local scripts/run-document-no-over-999.mjs",
    "db:migrate:can-view-cash": "node --env-file=.env.local scripts/run-can-view-cash-settings.mjs",
    "db:migrate:document-rls": "node --env-file=.env.local scripts/run-document-rls-lockdown.mjs",
    "db:migrate:atomic-writes": "node --env-file=.env.local scripts/run-atomic-document-writes.mjs",
    "db:migrate:atomic-deliveries": "node --env-file=.env.local scripts/run-atomic-deliveries.mjs",
    "test:money": "node scripts/test-money.mjs",
    "verify:cash": "node scripts/verify-cash-triggers.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.110.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/blob": "^2.8.0",
    "googleapis": "^150.0.1",
    "next": "^15.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "pg": "^8.23.0",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  }
