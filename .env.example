# ──────────────────────────────────────────────
# ระบบรับ-ส่งจดหมายพัสดุ และการควบคุมเอกสาร
# Environment Variables
# ──────────────────────────────────────────────
# ตั้งค่าผ่าน Cloudflare Worker secrets/variables หรือไฟล์ local สำหรับพัฒนา

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=doc-attachments

# ── Google Cloud API (OAuth2 — auto-create sheets, no manual setup) ──
# ใส่แค่ 3 ตัวนี้ ระบบจะสร้าง Sheet ขึ้นมาเอง
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxx

# ── หรือใช้ Service Account (manual setup) ──
# GOOGLE_SHEETS_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ── App ──
# โดเมน production จริงของโปรเจกต์นี้
# ค่านี้ถูกใช้ทำลิงก์ในอีเมลแจ้งเอกสารค้าง ถ้าว่างลิงก์จะหายไปทั้งบรรทัด
NEXT_PUBLIC_APP_URL=https://doc-tracking-system.store-hk.workers.dev
SUPER_ADMIN_EMAIL=store-hk@hillkoff.com
# ── Cloudflare Cron Worker (บังคับ) ──
# /api/cron/overdue-documents ถูกยกเว้นจากการตรวจ session ของ middleware
# ค่านี้จึงเป็นด่านเดียวที่กั้น route นั้น ถ้าไม่ตั้ง route จะตอบ 503 ทุกคำขอ
CRON_SECRET=generate-a-long-random-string
